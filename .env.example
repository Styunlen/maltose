# ─── Maltose environment template ─────────────────────────────────────────────
# Copy to .env and fill in values. Never commit the real .env.

# WordPress GraphQL endpoint (server-side, never exposed to browser).
WORDPRESS_API_URL=https://your-wp-domain.com/graphql

# Authentik OIDC (SSO login).
AUTHENTIK_ISSUER=https://your-authentik.example.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Authentik client used for the WordPress OAuth2 connection.
AUTHENTIK_WP_CLIENT_ID=

# Public app URL (used for redirects / cookies).
APP_URL=https://your-site.com
# Secret for signing the Astro session cookie.
APP_SECRET=

# GraphQL proxy request-signing secret (must match WP's signature verifier).
WP_GRAPHQL_SECRET_KEY=change-me
WP_SIGN_EXPIRE_SECONDS=60

# ─── Cache backend (ADR-0032) ─────────────────────────────────────────────────
# memory (default, single-process) | redis (shared, needs REDIS_URL) |
# lmdb (shared, embedded, no server — best for pm2 cluster without Redis).
GRAPHQL_CACHE_DRIVER=memory
# LMDB database directory (used when driver=lmdb).
GRAPHQL_CACHE_PATH=.cache/graphql
# LMDB map size in bytes (default 64MB).
GRAPHQL_CACHE_MAP_SIZE=67108864
# Periodic stale-entry cleanup interval in ms (0 disables).
GRAPHQL_CACHE_CLEANUP_MS=0

# Redis (used when driver=redis and for cross-process rate limiting).
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ─── Auth tokens (WP headless login) ──────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=

NODE_ENV=development
