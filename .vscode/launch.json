{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Astro Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 9229,
      "protocol": "inspector",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "resolveSourceMapLocations ": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "env": ["NODE_OPTIONS=--inspect=localhost:9229"]
    },
    {
      "command": "pnpm dev",
      "name": "Development server",
      "request": "launch",
      "type": "executable"
    }
  ]
}
