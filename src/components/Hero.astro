---
import HeroAceternityEffects from "./HeroAceternityEffects";
import { getBannerUrls } from "../lib/banner-urls";

const {
  title = "九仞之行",
  subtitle = "严于律己，宽以待人，深自警省，讷言敏行",
} = Astro.props;
const defaultSubtitle = "严于律己，宽以待人，深自警省，讷言敏行";
const bannerModules = import.meta.glob(
  "../assets/banner/*.{jpg,jpeg,png,webp,avif,svg}",
  { eager: true, query: "?url", import: "default" },
) as Record<string, string>;
const localBannerImages = Object.keys(bannerModules)
  .sort()
  .map((key) => bannerModules[key]);
const remoteBannerImages = await getBannerUrls();
const bannerImages =
  remoteBannerImages.length > 0 ? remoteBannerImages : localBannerImages;
for (let i = bannerImages.length - 1; i > 0; i -= 1) {
  const j = Math.floor(Math.random() * (i + 1));
  [bannerImages[i], bannerImages[j]] = [bannerImages[j], bannerImages[i]];
}
---

<!--
  Homepage banner (first viewport).
  The visual layer is a fixed backdrop that dissolves as the visitor scrolls
  into the content shell: progress = scrollY / innerHeight drives
  opacity: 1 - progress and blur: 20px * progress (reference mechanics).
  Background slides come from the runtime banner-urls JSON (remote URLs) or
  fall back to the bundled placeholders. Fast wheel gestures switch whole
  pages via the speed threshold (ADR-0041); slow ones scroll freely.
-->
<div class="brand-banner-backdrop" data-brand-backdrop aria-hidden="true">
  {
    bannerImages.length > 0 && (
      <div class="brand-carousel" data-brand-carousel>
        {bannerImages.map((source, index) => (
          <img
            class:list={["brand-carousel-img", index === 0 && "is-active"]}
            src={source}
            alt=""
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "low"}
            decoding="async"
            referrerpolicy="no-referrer"
          />
        ))}
      </div>
    )
  }
  {bannerImages.length > 0 && <div class="brand-banner-veil" />}
  <HeroAceternityEffects client:only="react" />
</div>

<section
  class="brand-hero"
  data-maltose-home-hero
  aria-labelledby="brand-hero-title"
  tabindex="-1"
>
  <div class="brand-hero-inner">
    <div class="brand-copy">
      <p class="brand-eyebrow font-mono">MALTOSE / HOME</p>
      <div class="brand-title-lockup">
        <span class="brand-seal font-display" aria-hidden="true">九</span>
        <h1 id="brand-hero-title" class="brand-title font-display">{title}</h1>
      </div>
      <p class="brand-slogan">
        {
          subtitle === defaultSubtitle ? (
            <>
              严于律己，宽以待人，<span class="cjk-keep">深自警省</span>
              ，讷言敏行
            </>
          ) : (
            subtitle
          )
        }
      </p>
    </div>

    <div class="brand-visual" aria-label="九仞之行插画">
      <div class="visual-shell">
        <img
          src="https://styunlen.cn/hello.png"
          alt="九仞之行品牌插画"
          width="640"
          height="640"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="brand-scroll-cue" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<script data-astro-rerun>
  (() => {
    const backdrop = document.querySelector("[data-brand-backdrop]");
    if (!(backdrop instanceof HTMLElement)) return;

    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let lastBlur = -1;
    let lastState = "";

    const update = () => {
      frame = 0;
      const progress = Math.min(
        Math.max(window.scrollY / Math.max(window.innerHeight, 1), 0),
        1,
      );
      backdrop.style.opacity = String(1 - progress);
      // Full-screen filter re-rasterization is costly; five blur steps look
      // identical to a continuous curve but update at most five times.
      const blur = media.matches ? 0 : Math.round(progress * 5) * 4;
      if (blur !== lastBlur) {
        lastBlur = blur;
        backdrop.style.filter = blur > 0 ? `blur(${blur}px)` : "none";
      }
      const state = progress >= 1 ? "hidden" : "visible";
      if (state !== lastState) {
        lastState = state;
        backdrop.dataset.state = state;
      }
    };

    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    const cleanup = () => {
      if (frame) window.cancelAnimationFrame(frame);
      frame = 0;
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
      media.removeEventListener("change", schedule);
      document.removeEventListener("astro:before-swap", cleanup);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    media.addEventListener("change", schedule);
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    update();
  })();
</script>

<script data-astro-rerun>
  (() => {
    const carousel = document.querySelector("[data-brand-carousel]");
    const slides =
      carousel instanceof HTMLElement
        ? Array.from(carousel.querySelectorAll(".brand-carousel-img"))
        : [];
    if (slides.length > 1) {
      const media = window.matchMedia("(prefers-reduced-motion: reduce)");
      let index = 0;
      slides.forEach((slide) =>
        slide.addEventListener(
          "error",
          () => slide.classList.add("is-broken"),
          { once: true },
        ),
      );
      const advance = () => {
        if (media.matches || document.hidden) return;
        const backdrop = document.querySelector("[data-brand-backdrop]");
        if (
          backdrop instanceof HTMLElement &&
          backdrop.dataset.state === "hidden"
        )
          return;
        for (let step = 1; step <= slides.length; step += 1) {
          const next = (index + step) % slides.length;
          if (slides[next].classList.contains("is-broken")) continue;
          slides[index].classList.remove("is-active");
          index = next;
          slides[index].classList.add("is-active");
          return;
        }
      };
      const timer = window.setInterval(advance, 5500);
      document.addEventListener(
        "astro:before-swap",
        () => window.clearInterval(timer),
        { once: true },
      );
    }
  })();
</script>

<style>
  .brand-banner-backdrop {
    --hero-panel: color-mix(in oklch, var(--mint-50) 72%, var(--background));
    --home-dot-color: color-mix(in oklch, var(--mint-700) 50%, transparent);
    --home-dot-color-dark: color-mix(
      in oklch,
      var(--mint-300) 50%,
      transparent
    );
    --home-glow-color: color-mix(in oklch, var(--primary) 75%, transparent);
    --home-glow-color-dark: color-mix(
      in oklch,
      var(--primary) 80%,
      transparent
    );
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 14% 18%,
        color-mix(in oklch, var(--primary) 36%, transparent),
        transparent 30%
      ),
      radial-gradient(
        circle at 86% 12%,
        color-mix(in oklch, var(--accent) 44%, transparent),
        transparent 32%
      ),
      linear-gradient(
        126deg,
        var(--hero-panel),
        color-mix(in oklch, var(--accent) 44%, var(--background)) 56%,
        var(--background)
      );
  }

  :global(.dark) .brand-banner-backdrop {
    --hero-panel: color-mix(in oklch, var(--mint-950) 54%, var(--background));
    background:
      radial-gradient(
        circle at 12% 18%,
        color-mix(in oklch, var(--primary) 24%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 86% 12%,
        color-mix(in oklch, var(--accent) 22%, transparent),
        transparent 34%
      ),
      linear-gradient(
        126deg,
        var(--hero-panel),
        color-mix(in oklch, var(--mint-900) 64%, var(--background)) 58%,
        var(--background)
      );
  }

  .brand-banner-backdrop[data-state="hidden"] {
    visibility: hidden;
  }

  .brand-carousel {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .brand-carousel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .brand-carousel-img.is-active {
    opacity: 1;
  }

  .brand-carousel-img.is-broken {
    display: none;
  }

  .brand-banner-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.68;
    background:
      radial-gradient(
        circle at 14% 18%,
        color-mix(in oklch, var(--primary) 36%, transparent),
        transparent 30%
      ),
      radial-gradient(
        circle at 86% 12%,
        color-mix(in oklch, var(--accent) 44%, transparent),
        transparent 32%
      ),
      linear-gradient(
        126deg,
        var(--hero-panel),
        color-mix(in oklch, var(--accent) 44%, var(--background)) 56%,
        var(--background)
      );
  }

  :global(.dark) .brand-banner-veil {
    background:
      radial-gradient(
        circle at 12% 18%,
        color-mix(in oklch, var(--primary) 24%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 86% 12%,
        color-mix(in oklch, var(--accent) 22%, transparent),
        transparent 34%
      ),
      linear-gradient(
        126deg,
        var(--hero-panel),
        color-mix(in oklch, var(--mint-900) 64%, var(--background)) 58%,
        var(--background)
      );
  }

  .brand-banner-backdrop::after {
    content: "";
    position: absolute;
    inset: clamp(0.75rem, 2vw, 1.5rem);
    z-index: -1;
    border: 1px solid color-mix(in oklch, var(--primary) 28%, var(--border));
    border-radius: calc(var(--radius) + 1rem);
    box-shadow: inset 0 0 0 1px
      color-mix(in oklch, var(--base-color-whiteboth) 34%, transparent);
    pointer-events: none;
  }

  :global(.hero-aceternity-effects) {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.hero-background-beams) {
    opacity: 0.34;
    filter: hue-rotate(92deg) saturate(0.72);
  }

  :global(.hero-dotted-glow) {
    opacity: 0.24;
    mask-image: radial-gradient(circle at 76% 55%, black, transparent 68%);
  }

  .brand-hero {
    --hero-edge: clamp(1rem, 4vw, 3rem);
    position: relative;
    display: grid;
    align-items: center;
    box-sizing: border-box;
    width: 100vw;
    min-height: 100dvh;
    margin: 0;
    overflow: clip;
    padding: clamp(3rem, 7vw, 6rem) var(--hero-edge);
  }

  .brand-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(18rem, 0.78fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    width: min(100%, 72rem);
    margin: 0 auto;
  }

  .brand-copy {
    min-width: 0;
  }

  .brand-eyebrow {
    margin: 0 0 1rem;
    color: var(--mint-700);
    font-size: clamp(0.72rem, 1.8vw, 0.82rem);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  :global(.dark) .brand-eyebrow {
    color: var(--mint-300);
  }

  .brand-title-lockup {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.4vw, 1.4rem);
    min-width: 0;
  }

  .brand-seal {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: clamp(3.6rem, 9vw, 6.25rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in oklch, var(--primary) 54%, var(--border));
    border-radius: calc(var(--radius) + 0.8rem);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklch, var(--primary) 24%, var(--card)),
        color-mix(in oklch, var(--accent) 46%, var(--card))
      ),
      var(--card);
    box-shadow:
      0 1rem 3rem -1.6rem color-mix(in oklch, var(--primary) 60%, transparent),
      inset 0 0 0 1px
        color-mix(in oklch, var(--base-color-whiteboth) 54%, transparent);
    color: var(--foreground);
    font-size: clamp(2rem, 5vw, 3.7rem);
    font-weight: 800;
    line-height: 1;
  }

  .brand-title {
    min-width: 0;
    margin: 0;
    color: var(--foreground);
    font-size: clamp(3.35rem, 10vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.08em;
    line-height: 0.92;
    white-space: nowrap;
  }

  .brand-slogan {
    max-width: 42rem;
    margin: clamp(1rem, 3vw, 1.6rem) 0 0;
    color: color-mix(in oklch, var(--foreground) 88%, var(--mint-700));
    font-size: clamp(1.25rem, 3.4vw, 2.7rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.04em;
  }

  .cjk-keep {
    white-space: nowrap;
  }

  :global(.dark) .brand-slogan {
    color: color-mix(in oklch, var(--foreground) 88%, var(--mint-300));
  }

  .brand-visual {
    position: relative;
    justify-self: center;
    box-sizing: border-box;
    width: min(100%, 28rem);
    min-width: 0;
    overflow: clip;
    padding: 0.7rem;
    border-radius: calc(var(--radius) + 1.25rem);
  }

  .visual-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--primary) 34%, var(--border));
    border-radius: calc(var(--radius) + 1rem);
    background: color-mix(in oklch, var(--card) 74%, var(--accent));
    box-shadow: 0 1.5rem 4rem -2rem
      color-mix(in oklch, var(--foreground) 42%, transparent);
  }

  .visual-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 55% 16%,
      color-mix(in oklch, var(--base-color-whiteboth) 56%, transparent),
      transparent 40%
    );
    pointer-events: none;
  }

  .visual-shell img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    min-height: clamp(17rem, 40vw, 31rem);
    object-fit: contain;
    filter: drop-shadow(
      0 1.2rem 1.6rem color-mix(in oklch, var(--foreground) 18%, transparent)
    );
  }

  .brand-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    color: color-mix(in oklch, var(--foreground) 52%, transparent);
    animation: brand-cue-bounce 2s ease-in-out infinite;
    pointer-events: none;
  }

  .brand-scroll-cue svg {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
  }

  @keyframes brand-cue-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.95;
    }
    50% {
      transform: translateY(0.5rem);
      opacity: 0.45;
    }
  }

  @media (max-width: 900px) {
    .brand-hero {
      width: 100%;
      min-height: 100dvh;
      padding-block: clamp(3rem, 10vw, 5rem);
    }

    .brand-hero-inner {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 7vw, 3rem);
    }

    .brand-visual {
      width: min(100%, 24rem);
    }
  }

  @media (max-width: 520px) {
    .brand-hero {
      --hero-edge: 1rem;
      padding-top: 3rem;
    }

    .brand-title-lockup {
      align-items: flex-start;
      flex-direction: column;
    }

    .brand-title {
      font-size: clamp(3rem, 20vw, 4.7rem);
    }

    .brand-slogan {
      font-size: clamp(1.15rem, 7vw, 1.7rem);
      line-height: 1.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.brand-banner-backdrop .hero-aceternity-effects) {
      display: none;
    }

    .brand-scroll-cue {
      animation: none;
    }
  }
</style>
