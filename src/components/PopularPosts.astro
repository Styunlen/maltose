---
import { getRandomPosts } from "@api/api";

const { first = 8, posts: propPosts } = Astro.props;

let posts: any[] = [];
try {
  posts = propPosts && propPosts.length > 0 ? propPosts : await getRandomPosts(first);
} catch (err) {
  console.warn("Failed to fetch random posts:", err);
}
const hasPosts = posts.length > 0;
---

{
  hasPosts && (
    <section class="popular-posts">
      <h2 class="popular-title">随机推荐</h2>
      <div class="popular-grid">
        {posts.map((post) => {
          const primaryCategory = post.categories?.nodes?.[0] || null;
          const viewCount = post.viewCount ?? 0;
          const commentCount = post.commentCount ?? 0;
          return (
            <a href={post.uri} class="popular-card">
              {primaryCategory && (
                <span class="popular-category">{primaryCategory.name}</span>
              )}
              <h3 class="popular-card-title">{post.title}</h3>
              <div class="popular-meta">
                <span>
                  <svg
                    class="meta-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                  </svg>
                  <span>{viewCount}</span>
                </span>
                <span>
                  <svg
                    class="meta-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                  {commentCount}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .popular-posts {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .popular-title {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--foreground);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .popular-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .popular-card:hover {
    transform: translateY(-2px);
    border-color: var(--mint-300);
  }

  .popular-category {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .popular-card-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .popular-card:hover .popular-card-title {
    color: var(--primary-color);
  }

  .popular-meta {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.2rem;
  }

  .popular-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .meta-icon {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
  }
</style>
