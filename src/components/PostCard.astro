---
import { LAZY_PLACEHOLDER } from "@/lib/lazy";
const { post } = Astro.props;

const formattedDate = new Date(post.date).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const primaryCategory = post.categories?.nodes?.[0] || null;
const tags = post.tags?.nodes || [];
const hasTags = tags.length > 0;
const commentCount = post.commentCount ?? 0;
const viewCount = post.viewCount ?? 0;
const hasImage = !!post.featuredImage?.node?.sourceUrl;

// Extract first image from content as fallback when no featuredImage
let fallbackImageUrl = "";
if (!hasImage && post.content) {
  // console.log(JSON.stringify(post, null, 2));
  const imgMatch = post.content.match(
    /<img[^>]+data-original=["']([^"']+)["']/i,
  );
  if (imgMatch && imgMatch[1]) {
    fallbackImageUrl = imgMatch[1];
  }
}
const displayImageUrl = hasImage
  ? post.featuredImage.node.sourceUrl
  : fallbackImageUrl;

// Clean excerpt: strip HTML, decode entities, remove WordPress [...] markers
function cleanExcerpt(html) {
  if (!html) return "";
  let text = html.replace(/<[^>]*>/g, "");
  text = text
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&hellip;/g, "…")
    .replace(/&mdash;/g, "—")
    .replace(/&nbsp;/g, " ")
    .trim();
  text = text.replace(/\[(?:&hellip;|…)\]|(?:&hellip;|…)/g, "…").trim();
  return text.length > 200 ? text.slice(0, 200) + "…" : text;
}
const excerpt = cleanExcerpt(post.excerpt);

// Generate a deterministic seed from the post title for random nature images
const imageSeed = encodeURIComponent(
  (post.title ?? "").replace(/[^a-zA-Z0-9\u4e00-\u9fa5]/g, "").slice(0, 20),
);
---

<article class="post-card mb-8">
  <!-- Image area (clickable, links to post) -->
  <a href={post.uri} class="card-image-link" tabindex="-1" aria-hidden="true">
    <div class="card-image-wrap">
      {
        displayImageUrl ? (
          <img
            src={LAZY_PLACEHOLDER}
            data-src={displayImageUrl}
            alt=""
            class="card-image lazy-img"
          />
        ) : (
          <img
            src={LAZY_PLACEHOLDER}
            data-src={`https://picsum.photos/seed/${imageSeed}/600/240`}
            alt=""
            class="card-image lazy-img"
            class="card-image"
          />
        )
      }

      <!-- Hover Overlay -->
      <div class="hover-overlay">
        <div class="overlay-content">
          <div class="overlay-row overlay-stats">
            <span class="overlay-stat">
              <svg
                class="stat-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
              {commentCount} 评论
            </span>
            <span class="overlay-stat">
              <svg
                class="stat-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
                ></path>
              </svg>
              {viewCount} 浏览
            </span>
          </div>
          {
            hasTags && (
              <div class="overlay-row overlay-tags">
                {tags.map((tag) => (
                  <span class="tag-pill">{tag.name}</span>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </a>

  <!-- Content (title is clickable, excerpt/meta are selectable) -->
  <div class="card-body">
    {
      primaryCategory && (
        <span class="card-category">{primaryCategory.name}</span>
      )
    }

    <a href={post.uri} class="card-title-link">
      <h3 class="card-title">{post.title}</h3>
    </a>

    {excerpt && <p class="card-excerpt">{excerpt}</p>}

    <div class="card-meta">
      <time datetime={post.date} class="card-date">{formattedDate}</time>
      <span class="card-comments">
        <svg
          class="meta-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
          ></path>
        </svg>
        {commentCount}
      </span>
      <span class="card-comments" title="浏览次数">
        <svg
          class="meta-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
          ></path>
        </svg>
        <span>{viewCount}</span>
      </span>
    </div>
  </div>
</article>

<style>
  /* ─── Card ─── */
  .post-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
  }

  /* ─── Image ─── */
  .card-image-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image-wrap {
    position: relative;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--muted);
  }

  .card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.05);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
  }

  /* ─── Image ─── */
  .card-image-wrap {
    position: relative;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--muted);
  }

  .card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.05);
  }

  /* ─── Hover Overlay ─── */
  .hover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.4) 60%,
      rgba(0, 0, 0, 0.15) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .post-card:hover .hover-overlay {
    opacity: 1;
  }

  .overlay-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .overlay-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .overlay-stats {
    gap: 1.25rem;
  }

  .overlay-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
  }

  .stat-icon {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
  }

  .overlay-tags {
    gap: 0.4rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
  }

  .tag-pill:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  /* ─── Body ─── */
  .card-body {
    padding: 1rem 1.25rem 1.2rem;
  }

  .card-category {
    display: inline-block;
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .post-card:hover .card-title {
    color: var(--primary-color);
  }

  .card-excerpt {
    margin: 0.4rem 0 0;
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }

  .card-date {
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }

  .card-comments {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }

  .meta-icon {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .card-body {
      padding: 0.8rem 1rem 1rem;
    }
    .card-title {
      font-size: 1rem;
    }
    .hover-overlay {
      padding: 1rem;
    }
  }
</style>
