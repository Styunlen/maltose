<style>
  footer {
    text-align: center;
    padding: 2rem;
    margin-top: 3rem;
    background: var(--background);
    border: 3px dashed var(--border);
    border-radius: var(--radius);
    color: var(--foreground);
    font-weight: 600;
  }
  footer div {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 1rem 0;
    align-items: center;
  }
  footer a {
    color: var(--primary);
    text-decoration: none;
  }
  footer a:hover {
    text-decoration: underline;
  }
  .my-face {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
    animation: wave 2s infinite;
  }
  @keyframes wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(10deg);
    }
    75% {
      transform: rotate(-10deg);
    }
  }
</style>
<hr style="border: none; margin-top: 2rem;" />
