---
import PostCard from "../PostCard.astro";

const { node } = Astro.props;
---

<h1>{node.name} <span class="archive-deco" aria-hidden="true">✿</span></h1>

<div class="archive-list">
  {(node.posts?.nodes || []).map(post => {
    return (
      <PostCard post={post} />
    )
  })}
</div>

<style>
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    text-shadow: 3px 3px 0px var(--border);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .archive-deco {
    font-size: 1.8rem;
    display: inline-block;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .archive-list {
    margin-top: 2rem;
  }
</style>
