---
import PostCard from "../PostCard.astro";
import Pagination from "../Pagination.astro";

interface Props {
  node: any;
  page?: number;
  perPage?: number;
  totalPosts?: number;
  basePath?: string;
}

const { node, page = 1, perPage = 10, totalPosts = 0, basePath = "/" } = Astro.props;
const totalPages = Math.max(1, Math.ceil(totalPosts / perPage));
// Category/Tag posts are fetched in full (first:100); slice client-side.
const allPosts = node.posts?.nodes || [];
const startIdx = (page - 1) * perPage;
const posts = allPosts.slice(startIdx, startIdx + perPage);
---

<h1>
  {node.name} <span class="archive-deco" aria-hidden="true">✿</span>
</h1>

<div class="archive-list">
  {posts.length > 0 ? (
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <p class="archive-empty">这个目录下还没有文章</p>
  )}
</div>

{totalPages > 1 && (
  <Pagination
    currentPage={page}
    totalPages={totalPages}
    hasNextPage={page < totalPages}
    hasPreviousPage={page > 1}
    basePath={basePath}
  />
)}

<style>
  h1 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary);
    text-shadow: 3px 3px 0px var(--border);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .archive-deco {
    font-size: 1.5rem;
    display: inline-block;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .archive-list {
    margin-top: 2rem;
  }

  /* 与首页 post-grid 同步：移动 1 列 / ≥768px 2 列 */
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  :global(.post-grid .post-card) {
    margin-bottom: 0;
  }
  @media (min-width: 768px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .archive-empty {
    text-align: center;
    color: var(--muted-foreground);
    padding: 3rem 0;
    font-size: 0.9rem;
  }
</style>
