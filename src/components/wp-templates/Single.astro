---
import WordPressBlocks from "@components/WordPressBlocks";
import wpBlocks from "@components/wp-blocks";
import { gql } from "@apollo/client/core";
const { node } = Astro.props;
import { LiquidButton } from "@components/animate-ui/buttons/liquid.tsx";
import dayjs from "dayjs";
import {
  getQuery,
  getRandomPosts,
  getAdjacentPosts,
  layoutQuery,
  countContentWords,
} from "@api/api";
import { renderCommentMd } from "@lib/markdown";
import CommentSection from "../CommentSection";

// Blogger's WordPress user ids (from env, comma-separated, default [1]).
// Multiple ids cover legacy duplicate accounts (e.g. 1 and 97) so every
// comment by the owner gets the 博主 badge.
const siteOwnerUserIds = (
  process.env.BLOG_OWNER_USER_IDS ||
  process.env.BLOG_OWNER_USER_ID ||
  "1"
)
  .split(",")
  .map((s: string) => Number(s.trim()))
  .filter((n: number) => !Number.isNaN(n) && n > 0);
const siteOwnerUserId = siteOwnerUserIds[0] || 1;
import ArticlePagination from "../ArticlePagination";
import PostViewCounter from "../PostViewCounter";
export const prerender = false;

// console.log(node.id)
const isPost = node.__typename === "Post";
const isPage = node.__typename === "Page";

// Render comment markdown to HTML during SSR, preserve raw for editing
const renderedComments = (node.comments?.nodes ?? []).map((c: any) => ({
  ...c,
  rawContent: c.content || "",
  content: renderCommentMd(c.content || ""),
  children: (c.children || []).map((child: any) => ({
    ...child,
    rawContent: child.content || "",
    content: renderCommentMd(child.content || ""),
  })),
}));

// Fetch editor blocks for both Post and Page
let rootBlocks: any[] = [];

if(!isPost && !isPage) {
  return 
}

if (isPost || isPage) {
  const contentNodeId = node.id;
  const fragmentEntries = Object.values(wpBlocks)
    .filter((item: any) => item?.fragments)
    .map((block: any) => block.fragments.entry)
    .join("");

const fragmentKeys = Object.values(wpBlocks)
  .filter((item:any) => item.fragments)
  .map((block:any) => `...${block.fragments.key}`)
  .join("  \n");

const queryString = `
  ${fragmentEntries}
  query GetPost($databaseId: ID!, $asPreview: Boolean!) {
    ${node.__typename.toLowerCase()}(id: $databaseId, asPreview: $asPreview) {
        editorBlocks {
          name
          clientId
          parentClientId
          renderedHtml
          type
          cssClassNames
          ${fragmentKeys}
      }
    }
  }
`;
  // console.log(queryString)
const queryResult = 
  (await getQuery(gql(queryString), {
    databaseId: node.id,
    asPreview: false,
  })) as any
// console.log("GraphQL query result for post ID", node.id, ":", JSON.stringify(queryResult, null, 2));
  const rawBlocks = (queryResult as any)?.[node.__typename.toLowerCase()]?.editorBlocks || [];

// console.log("Fetched raw blocks for post ID", node.id, ":", JSON.stringify(rawBlocks, null, 2));
// Transform raw blocks to our supported block format
const postBlocks = rawBlocks.map((block) => {
  let attributes = {};
  if (block.attributes) {
    attributes = block.attributes;
  }
  if (!(attributes as any).content && block.renderedHtml) {
    (attributes as any).content = block.renderedHtml;
  }
  return {
    name: block.name,
    renderedHtml: block.renderedHtml,
    clientId: block.clientId,
    parentClientId: block.parentClientId,
    attributes,
    cssClassNames: block.cssClassNames,
    type: block.type,
    innerBlocks: [],
  };
});

// Build block tree
const blockMap = new Map();
postBlocks.forEach((block) => blockMap.set(block.clientId, block));
postBlocks.forEach((block) => {
  if (block.parentClientId && blockMap.has(block.parentClientId)) {
    const parent = blockMap.get(block.parentClientId);
    parent.innerBlocks.push(block);
  } else {
    rootBlocks.push(block);
  }
});
}
// Split blocks into pages at CoreNextpage markers
const pageBlocks: any[][] = [];
let currentPage: any[] = [];
rootBlocks.forEach((block) => {
  if (block.type === "CoreNextpage" || block.name === "core/nextpage") {
    if (currentPage.length > 0) {
      currentPage.push(block);
      pageBlocks.push(currentPage);
      currentPage = [];
    }
  } else {
    currentPage.push(block);
  }
});
if (currentPage.length > 0) pageBlocks.push(currentPage);

const hasPages = pageBlocks.length > 1;
const totalPages = pageBlocks.length;

// ── Hero cover ────────────────────────────────────────────────────────────
const featuredImage = node.featuredImage?.node?.sourceUrl;

// ── Reading stats (honest, derived from real content — no fabrication) ────
const wordCount = countContentWords(node.content ?? "");
const readingMinutes = Math.max(1, Math.round(wordCount / 300));

// ── Info-staleness notice: flag posts last modified long ago ───────────────
// Days since the last modification; used to decide whether to show the
// "信息可能已经过时" hint under the timestamps.
const modifiedDate = node.modified ? new Date(node.modified) : null;
const daysSinceModified = modifiedDate
  ? Math.max(
      0,
      Math.floor(
        (Date.now() - modifiedDate.getTime()) / (1000 * 60 * 60 * 24),
      ),
    )
  : 0;
const STALENESS_THRESHOLD_DAYS = 90;
const showStalenessNotice = isPost && daysSinceModified > STALENESS_THRESHOLD_DAYS;
// 文章标签（旧站的"信息过期提醒"下方曾直接显示标签行，现放正文末尾）。
const postTags = node.tags?.nodes ?? [];
// 与 PostCard 相同的确定性五色 mood 映射，保证同站标签颜色一致。
const TAG_HUES = ["mint", "magenta", "violet", "coral", "amber"];
function tagHue(name: string): string {
  if (!name) return "mint";
  let hash = 0;
  for (let i = 0; i < name.length; i++)
    hash = (hash * 31 + name.charCodeAt(i)) >>> 0;
  return TAG_HUES[hash % TAG_HUES.length];
}

// Plain text for the summary block: strip tags + entities, collapse spaces
const bodyText = (node.content ?? "")
  .replace(/<[^>]*>/g, " ")
  .replace(/&[a-zA-Z#0-9]+;/g, " ")
  .replace(/\s+/g, " ")
  .trim();
const SUMMARY_LEN = 200;
const summaryText = bodyText.slice(0, SUMMARY_LEN);
const showSummary = bodyText.length > SUMMARY_LEN;

// ── Author card + related posts (fetched in-component: SSR supports await) ─
let siteInfo = { title: "", description: "" };
let relatedPosts: any[] = [];
try {
  const layout = await layoutQuery();
  siteInfo = {
    title: layout?.generalSettings?.title ?? "",
    description: layout?.generalSettings?.description ?? "",
  };
} catch (err) {
  console.warn("[Single] layoutQuery failed:", err);
}
try {
  const pool = await getRandomPosts(4);
  relatedPosts = pool
    .filter((p: any) => p.databaseId !== node.databaseId && p.uri !== node.uri)
    .slice(0, 2);
} catch (err) {
  console.warn("[Single] getRandomPosts failed:", err);
}
// 上一篇/下一篇（按发布时间邻接；仅 Post 有，Page 无）
let prevPost: any = null;
let nextPost: any = null;
if (isPost && node.date) {
  try {
    const adj = await getAdjacentPosts(node.date);
    prevPost = adj.prevPost;
    nextPost = adj.nextPost;
  } catch (err) {
    console.warn("[Single] getAdjacentPosts failed:", err);
  }
}
---

{
  isPost ? (
    <header
      class:list={[
        "post-hero",
        featuredImage ? "post-hero--cover" : "post-hero--plain",
      ]}
    >
      {
        featuredImage && (
          <div class="post-hero__media">
            <img
              class="post-hero__img"
              src={featuredImage}
              srcset={node.featuredImage?.node?.srcSet}
              sizes="(min-width: 768px) 800px, 100vw"
              alt={node.featuredImage?.node?.altText ?? ""}
              width={node.featuredImage?.node?.mediaDetails?.width}
              height={node.featuredImage?.node?.mediaDetails?.height}
              loading="eager"
              fetchpriority="high"
            />
            <div class="post-hero__overlay" aria-hidden="true" />
          </div>
        )
      }

      <div class="post-hero__content">
        <h1 class="post-hero__title font-display">{node.title}</h1>

        <div class="term-links">
          {
            node.categories?.nodes?.length > 0
              ? node.categories.nodes.map((category) => (
                  <LiquidButton
                    className="term-link"
                    href={category.uri}
                    style={{
                      background:
                        "var(--term-link-bg, color-mix(in oklch, var(--muted) 100%, transparent)) !important",
                      color: "var(--term-link-fg, var(--muted-foreground)) !important",
                      border:
                        "1px solid var(--term-link-border, var(--border)) !important",
                    }}
                  >
                    {category.name}
                  </LiquidButton>
                ))
              : null
          }
        </div>

        <div class="post-meta">
          <PostViewCounter
            postId={node.databaseId}
            initialCount={node.viewCount ?? 0}
            client:load
          />
          {wordCount > 0 && (
            <>
              <span class="meta-item" title="字数">
                <span class="meta-icon-chip chip-coral" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 10H3" />
                    <path d="M21 6H3" />
                    <path d="M21 14H3" />
                    <path d="M17 18H3" />
                  </svg>
                </span>
                {wordCount.toLocaleString("en-US")} 字
              </span>
              <span class="meta-item" title="阅读时长">
                <span class="meta-icon-chip chip-violet" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                </span>
                {readingMinutes} 分钟
              </span>
            </>
          )}
        </div>
      </div>
    </header>
  ) : (
    <header class="page-header">
      <h1 class="page-header__title font-display">{node.title}</h1>
      <div class="page-header__meta">
        {node.date && (
          <time datetime={node.date}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <path d="M16 2v4" />
              <path d="M8 2v4" />
              <path d="M3 10h18" />
            </svg>
            发布于 {dayjs(node.date).format("YYYY-MM-DD")}
          </time>
        )}
        {node.modified && node.modified !== node.date && (
          <time datetime={node.modified} title="最后修改">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
              <path d="M21 3v5h-5" />
            </svg>
            更新于 {dayjs(node.modified).format("YYYY-MM-DD")}
          </time>
        )}
      </div>
    </header>
  )
}

{
  isPost ? (
    <>
      <div class="divider" aria-hidden="true">✿ ✿ ✿</div>

      <article class="post-content">
        <div class="post-timestamps">
          <time datetime={node.date}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <path d="M16 2v4" />
              <path d="M8 2v4" />
              <path d="M3 10h18" />
            </svg>
            发布于 {dayjs(node.date).format("YYYY-MM-DD HH:mm")}
          </time>
          <time datetime={node.modified} title="最后修改">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
              <path d="M21 3v5h-5" />
            </svg>
            更新于 {dayjs(node.modified).format("YYYY-MM-DD HH:mm")}
          </time>
        </div>
        {
          showStalenessNotice && (
            <div class="staleness-notice" role="note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
              </svg>
              <span>
                本文发布于 {dayjs(node.date).format("YYYY-MM-DD")}，
                最后更新于 {daysSinceModified} 天前，其中的信息可能已经有所发展或是发生改变。
              </span>
            </div>
          )
        }
        {
          showSummary && (
            <section class="summary-card" aria-labelledby="article-summary-title">
              <div class="summary-head">
                <h2 id="article-summary-title" class="summary-title font-display">文章摘要</h2>
                <button id="article-summary-shuffle" class="summary-shuffle" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
                    <path d="M21 3v5h-5" />
                  </svg>
                  换一条
                </button>
              </div>
              <p id="article-summary-text" class="summary-text" aria-live="polite">{summaryText}…</p>
              <span id="article-summary-full" hidden>{bodyText}</span>
            </section>
          )
        }

        {
          hasPages ? (
            <div class="article-pages" id="article-pages">
              {pageBlocks.map((blocks, i) => (
                <div id={`page-${i + 1}`} class="article-page">
                  <WordPressBlocks blocks={blocks} client:load />
                </div>
              ))}
            </div>
          ) : (
            <WordPressBlocks blocks={rootBlocks || []} client:load />
          )
        }

        {hasPages && (
          <ArticlePagination totalPages={totalPages} client:load />
        )}

        {
          postTags.length > 0 && (
            <div class="post-tags" aria-label="文章标签">
              <div class="post-tags-list">
                {postTags.map((tag: any) => (
                  <a
                    class={`post-tag tag-${tagHue(tag.name)}`}
                    href={tag.uri}
                    key={tag.uri}
                  >
                    <svg class="post-tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
                      <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
                    </svg>
                    {tag.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <section class="post-end" aria-label="作者与相关推荐">
          {
            siteInfo.title && (
              <div class="author-card">
                <div class="author-avatar" aria-hidden="true">
                  {siteInfo.title.trim().charAt(0) || "博"}
                </div>
                <div class="author-info">
                  <p class="author-name font-display">{siteInfo.title}</p>
                  {siteInfo.description && (
                    <p class="author-bio">{siteInfo.description}</p>
                  )}
                </div>
                <div class="author-actions">
                  <a class="author-btn author-btn--primary" href="/about">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 11a9 9 0 0 1 9 9" />
                      <path d="M4 4a16 16 0 0 1 16 16" />
                      <circle cx="5" cy="19" r="1" />
                    </svg>
                    <span>订阅</span>
                  </a>
                  <button class="author-btn author-btn--ghost" type="button" data-share-post>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                      <polyline points="16 6 12 2 8 6" />
                      <line x1="12" x2="12" y1="2" y2="15" />
                    </svg>
                    <span data-share-label>分享</span>
                  </button>
                </div>
              </div>
            )
          }

          <div class="copyright-card" aria-label="著作权声明">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M14.5 9a3.5 3.5 0 1 0 0 6" />
            </svg>
            <div class="copyright-body">
              <p class="copyright-license">
                本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> 协议进行授权，如无注明均为原创，转载请注明出处。
              </p>
              <p class="copyright-facts">
                <span>标题：{node.title}</span>
                <span>作者：{siteInfo.title || "本站"}</span>
                <span>
                  链接：
                  <a href={Astro.url.href} rel="nofollow">{Astro.url.href}</a>
                </span>
              </p>
            </div>
          </div>

          {/* 上一篇/下一篇：读完正文 → 分享/评论互动 → 继续阅读邻接文章 */}
          {(prevPost || nextPost) && (
            <nav class="adjacent-nav" aria-label="上一篇下一篇">
              {prevPost ? (
                <a class="adjacent-link adjacent-link--prev" href={prevPost.uri}>
                  <span class="adjacent-direction">← 上一篇</span>
                  <span class="adjacent-title">{prevPost.title}</span>
                </a>
              ) : (
                <span class="adjacent-link adjacent-link--empty" aria-hidden="true" />
              )}
              {nextPost ? (
                <a class="adjacent-link adjacent-link--next" href={nextPost.uri}>
                  <span class="adjacent-direction">下一篇 →</span>
                  <span class="adjacent-title">{nextPost.title}</span>
                </a>
              ) : (
                <span class="adjacent-link adjacent-link--empty" aria-hidden="true" />
              )}
            </nav>
          )}
        </section>

        <CommentSection 
          client:load
          comments={renderedComments}
          commentCount={node.commentCount ?? 0}
          commentStatus={node.commentStatus ?? "closed"}
          postUri={node.uri}
          postDatabaseId={node.databaseId}
          user={Astro.locals.user}
          currentUserId={Astro.locals.wpUserId}
          siteOwnerUserIds={siteOwnerUserIds}
        />

        {
          relatedPosts.length > 0 && (
            <div class="related-section">
              <h2 class="related-title font-display">喜欢这篇文章的人也看了</h2>
              <div class="related-grid">
                {relatedPosts.map((p) => (
                  <a class="related-card" href={p.uri}>
                    {p.featuredImage?.node?.sourceUrl ? (
                      <img
                        class="related-thumb"
                        src={p.featuredImage.node.sourceUrl}
                        alt=""
                        loading="lazy"
                        width={p.featuredImage?.node?.mediaDetails?.width}
                        height={p.featuredImage?.node?.mediaDetails?.height}
                      />
                    ) : (
                      <span class="related-thumb related-thumb--empty" aria-hidden="true" />
                    )}
                    <span class="related-body">
                      <span class="related-card-title">{p.title}</span>
                      <span class="related-card-meta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect width="18" height="18" x="3" y="4" rx="2" />
                          <path d="M16 2v4" />
                          <path d="M8 2v4" />
                          <path d="M3 10h18" />
                        </svg>
                        {dayjs(p.date).format("YYYY-MM-DD")}
                        <span aria-hidden="true">·</span>
                        {p.viewCount ?? 0} 浏览
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </article>


      <script
        type="application/json"
        id="article-comment-data"
        set:html={JSON.stringify({
          comments: renderedComments,
          commentCount: node.commentCount ?? 0,
          commentStatus: node.commentStatus ?? "closed",
          postUri: node.uri,
        })}
      ></script>
    </>
  ) : (
    <>
      <article class="page-content">
        {
          hasPages ? (
            <div class="article-pages" id="article-pages">
              {pageBlocks.map((blocks, i) => (
                <div id={`page-${i + 1}`} class="article-page">
                  <WordPressBlocks blocks={blocks} client:load />
                </div>
              ))}
            </div>
          ) : (
            <WordPressBlocks blocks={rootBlocks || []} client:load />
          )
        }
        {hasPages && (
          <ArticlePagination totalPages={totalPages} client:load />
        )} 
        <CommentSection 
          client:load
          comments={renderedComments}
          commentCount={node.commentCount ?? 0}
          commentStatus={node.commentStatus ?? "closed"}
          postUri={node.uri}
          postDatabaseId={node.databaseId}
          user={Astro.locals.user}
          currentUserId={Astro.locals.wpUserId}
          siteOwnerUserIds={siteOwnerUserIds}
        />
      </article>

      <script
        type="application/json"
        id="article-comment-data"
        set:html={JSON.stringify({
          comments: renderedComments,
          commentCount: node.commentCount ?? 0,
          commentStatus: node.commentStatus ?? "closed",
          postUri: node.uri,
        })}
      ></script>
    </>
  )
}

<script>
  const summaryText = document.getElementById("article-summary-text");
  const summaryFull = document.getElementById("article-summary-full");
  const shuffleBtn = document.getElementById("article-summary-shuffle");
  if (summaryText && summaryFull && shuffleBtn) {
    const full = summaryFull.textContent || "";
    const LEN = 200;
    let currentOffset = 0;
    const render = (offset: number) => {
      const slice = full.slice(offset, offset + LEN);
      summaryText.textContent = offset + LEN < full.length ? slice + "…" : slice;
    };
    shuffleBtn.addEventListener("click", () => {
      const maxOffset = Math.max(0, full.length - LEN);
      let next = Math.floor(Math.random() * (maxOffset + 1));
      if (Math.abs(next - currentOffset) < 80) next = (next + 120) % (maxOffset + 1);
      currentOffset = next;
      render(next);
    });
  }

  const shareBtn = document.querySelector("[data-share-post]");
  if (shareBtn) {
    shareBtn.addEventListener("click", async () => {
      const url = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
          return;
        } catch (err) {
          if (err && (err as any).name === "AbortError") return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        const label = shareBtn.querySelector("[data-share-label]");
        if (label) {
          const original = label.textContent;
          label.textContent = "已复制";
          setTimeout(() => { label.textContent = original; }, 2000);
        }
      } catch {}
    });
  }
