---
import "@/styles/tailwind.css";
import "@/styles/global.scss";
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/SiteFooter.astro";
import LayoutShell from "./LayoutShell";
import {
  layoutQuery,
} from "@api/api.ts";

let primaryMenu: any = null;
let generalSettings: any = { title: "AstroPress", url: "", description: "" };
const { title, description, sidebarData = null } = Astro.props;

try {
  // Layout-level query: only site chrome (menu + site identity) needed by
  // every page. Homepage-only sidebar content (posts/comments/tags/archive)
  // is fetched by index.astro and passed down via the sidebarData prop (see
  // ADR-0013: layout vs page data separation).
  const data = await layoutQuery();
  primaryMenu = data.menus?.nodes?.[0] ?? null;
  if (data.generalSettings) generalSettings = data.generalSettings;
} catch (err) {
  console.warn("Layout query failed, using fallback:", err);
}

const pageTitle = `${title} | ${generalSettings.title}`;
---

<html lang="en">
  <head>
    <!-- First-frame stability for the right sidebar (dev-only FOUC fix).
         Astro dev inlines component CSS as <style data-vite-dev-id> AFTER
         this head content, so on a streamed first paint the sidebar's
         Tailwind classes (.hidden/.2xl:flex/.fixed) may not have applied
         yet → it renders unstyled then jumps. These rules are emitted here
         (is:inline = verbatim, stays at the top of head) so the right
         sidebar occupies its fixed slot from the very first paint.
         !important beats the later-injected Tailwind .hidden (same
         specificity, later source wins otherwise). Production is unaffected
         (CSS is a render-blocking <link>), but the rules are harmless there
         too. Keep in sync with SidebarRight.tsx / animate-ui sidebar.tsx. -->
    <style is:inline>
      [data-slot="sidebar-container"][data-side="right"] {
        display: none !important;
      }
      @media (min-width: 1536px) {
        [data-slot="sidebar-container"][data-side="right"] {
          display: flex !important;
        }
      }
    </style>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title} | ${generalSettings.title}`}</title>
    <meta name="description" content={description} />
    {/* canonical 去掉查询参数（如 ?page=N、?x=），分页页指向自身路径 */}
    <link rel="canonical" href={Astro.url.origin + Astro.url.pathname} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Nunito:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply theme before first paint to avoid a flash of the wrong mode.
      // is:inline → emitted verbatim (not TS-bundled by Astro).
      (() => {
        const stored = localStorage.getItem("theme");
        const dark =
          stored === "dark" ||
          (stored !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <LayoutShell
      menu={primaryMenu}
      generalSettings={generalSettings}
      sidebarData={sidebarData}
      initialUser={Astro.locals.user ?? null}
      pathname={Astro.url.pathname}
      client:load
    >
      <slot />
      <SiteFooter />
    </LayoutShell>
  </body>
</html>

<script>
  import "../scripts/build-info.ts";
</script>

<script>
  import LazyLoad from "vanilla-lazyload";

  const instance = new LazyLoad({
    elements_selector: ".lazy-img",
  });

  // Observe <html>, not <body>: ClientRouter swaps the whole body element on
  // navigation, which would detach an observer attached to the old body node.
  const observer = new MutationObserver(() => instance.update());
  observer.observe(document.documentElement, { childList: true, subtree: true });

  document.addEventListener("astro:page-load", () => instance.update());

  // Smooth scrolling during view-transition navigation: opt <html> into
  // `scroll-behavior: smooth` (see `.smooth-scroll` in tailwind.css) while the
  // router animates the scroll-to-top, then drop the class after the page
  // settles so ordinary programmatic scrolls stay instant.
  document.addEventListener("astro:before-preparation", () => {
    document.documentElement.classList.add("smooth-scroll");
  });
  document.addEventListener("astro:page-load", () => {
    setTimeout(() => document.documentElement.classList.remove("smooth-scroll"), 500);
  });

  // Navigation progress bar: ClientRouter fetches the next page's SSR HTML
  // before swapping; during that fetch the old page stays visible but there's
  // no feedback. A thin top progress bar (YouTube-style) tells the user a
  // transition is in flight, then clears on swap. The bar lives on
  // document.documentElement and is located by query on removal — the swap
  // replaces the body, so a captured element reference would go stale.
  const navProgress = (() => {
    let raf = 0;
    let progress = 0;
    const find = () =>
      Array.from(document.querySelectorAll("div")).find(
        (d) => d.style.position === "fixed" && d.style.height === "2px" && d.style.zIndex === "9999",
      ) as HTMLElement | undefined;
    const tick = () => {
      progress = progress + (0.9 - progress) * 0.15;
      const el = find();
      if (el) el.style.transform = `scaleX(${progress})`;
      raf = requestAnimationFrame(tick);
    };
    return {
      show() {
        if (find()) return;
        const el = document.createElement("div");
        el.style.cssText =
          "position:fixed;top:0;left:0;right:0;height:2px;z-index:9999;" +
          "background:var(--primary);transform-origin:left;transform:scaleX(0);" +
          "transition:transform .1s linear;";
        document.documentElement.appendChild(el);
        progress = 0;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(tick);
      },
      done() {
        cancelAnimationFrame(raf);
        const el = find();
        if (el) {
          el.style.transform = "scaleX(1)";
          setTimeout(() => el.remove(), 250);
        }
      },
    };
  })();
  document.addEventListener("astro:before-preparation", navProgress.show);
  document.addEventListener("astro:after-swap", navProgress.done);
  document.addEventListener("astro:page-load", navProgress.done);

  // ClientRouter navigation swaps the whole <html> attributes (swapRootAttributes
  // copies the new SSR doc's <html>, which has no `dark` class because SSR
  // doesn't know the client's theme) and does NOT re-run the head inline theme
  // script. Re-apply the theme on every swap so the page doesn't flash from
  // light to dark mid-navigation.
  const applyTheme = () => {
    const stored = localStorage.getItem("theme");
    const dark =
      stored === "dark" ||
      (stored !== "light" &&
        matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
  };
  document.addEventListener("astro:after-swap", applyTheme);
  document.addEventListener("astro:page-load", applyTheme);
</script>

<style>
  html,
  body {
    overflow-x: clip;
  }
  body {
    font-family: "Nunito", "MiSans", "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
    font-size: 18px;
    /* Subtle dot grid — kept light so prose stays readable; dark mode dims it. */
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 24px 24px;
  }
</style>
