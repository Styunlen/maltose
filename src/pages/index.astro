---
import PostCard from "../components/PostCard.astro";
import PopularPosts from "../components/PopularPosts.astro";
import StickyCarousel from "../components/StickyCarousel.astro";
import Pagination from "../components/Pagination.astro";
import MaintenancePage from "../components/MaintenancePage.astro";
import MainLayout from "../layouts/MainLayout.astro";
import {
  homePagePostsQuery,
  megaQuery,
  getTimelineStats,
  shuffle,
} from "@api/api";

const perPage = 10;

// Get current page from URL query param
const url = Astro.url;
const pageParam = url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);
const offset = (currentPage - 1) * perPage;

let posts: any[] = [];
let stickyPosts: any[] = [];
let popularPosts: any[] = [];
let sidebarData: any = null;
let total = 0;
let hasError = false;

try {
  const [data, mega, archivePosts] = await Promise.all([
    homePagePostsQuery(perPage, offset),
    megaQuery({
      sidebarPosts: 5,
      recentComments: 5,
      randomFirst: 30,
      includeSticky: true,
    }),
    getTimelineStats(),
  ]);
  posts = data.posts.nodes;
  total = data.posts.pageInfo?.offsetPagination?.total ?? 0;
  stickyPosts = mega.stickyPosts ?? [];
  // 随机推荐：取 mostViewedPosts 候选池并洗牌（替代 getRandomPosts）
  popularPosts = shuffle(mega.mostViewedPosts ?? []).slice(0, 8);
  // Homepage sidebar is homepage-only content — fetched here and passed down
  // through MainLayout so article/utility pages never fetch it (see ADR-0013).
  sidebarData = {
    posts: mega.recentPosts?.nodes ?? [],
    tags: mega.allTags?.nodes ?? [],
    categories: mega.allCategories?.nodes ?? [],
    comments: mega.recentComments?.nodes ?? [],
    archivePosts,
  };
} catch (err) {
  console.warn("Failed to fetch homepage data:", err);
  hasError = true;
}

const totalPages = Math.max(1, Math.ceil(total / perPage));

// Homepage contains live view counts, so it must not be cached by proxies.
Astro.response.headers.set("Cache-Control", "no-cache, must-revalidate");
---

{
  hasError ? (
    <MaintenancePage />
  ) : (
    <MainLayout
      title="Home Page"
      sidebarData={sidebarData}
    >
      <main style="margin-top: 1.5rem;">
        <StickyCarousel posts={stickyPosts} />

        <PopularPosts first={8} posts={popularPosts} />

        <h2 style="font-weight: 700; font-size: 1.25rem; color: var(--foreground); margin-top: 2.5rem; margin-bottom: 1rem; letter-spacing: 0.02em;">
          {currentPage === 1 ? "Recent Posts" : `Page ${currentPage}`}
        </h2>

        <div>
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>

        {totalPages > 1 && (
          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            hasNextPage={currentPage < totalPages}
            hasPreviousPage={currentPage > 1}
          />
        )}
      </main>
    </MainLayout>
  )
}
