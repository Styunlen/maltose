---
import HomePage from "../../components/HomePage.astro";

// 首页分页：/page/2、/page/3 … 路径式（SEO 优于 ?page=N 参数）。
export const prerender = false;

const pageNum = parseInt(Astro.params.page || "1", 10);
const currentPage = Number.isNaN(pageNum) ? 1 : Math.max(1, pageNum);
---

<HomePage currentPage={currentPage} title={`Page ${currentPage}`} />
