---
export const prerender = false;
import MainLayout from "@/layouts/MainLayout.astro";
import UserComments from "@/components/UserComments";

const wpToken = Astro.locals.wpToken;
const user = Astro.locals.user;
---

<MainLayout title="我的评论">
  <div>
    {!wpToken || !user ? (
      <div style="text-align: center; padding: 3rem 1rem; max-width: 800px; margin: 1.5rem auto 0;">
        <p style="font-size: 1rem; color: var(--muted-foreground); margin-bottom: 1rem;">
          请先登录后查看评论
        </p>
        <a
          href="/api/auth/login?redirect=/user/comments"
          style={{
            display: "inline-block",
            padding: "0.55rem 1.5rem",
            fontSize: "0.9rem",
            fontWeight: 700,
            color: "#000",
            background: "var(--primary)",
            borderRadius: 9999,
            textDecoration: "none",
          }}
        >
          去登录
        </a>
      </div>
    ) : (
      <UserComments client:load />
    )}
  </div>
</MainLayout>
